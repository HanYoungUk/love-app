{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "//": "Flutter 웹은 파일 이름에 해시를 안 붙인다. main.dart.js는 매 빌드마다 내용만 바뀌고 이름은 그대로다. 그래서 immutable을 걸면 브라우저가 1년간 서버에 물어보지도 않아 새 배포가 영영 안 보인다. no-cache는 '캐시하지 마라'가 아니라 '쓰기 전에 물어봐라'라서, 안 바뀌었으면 304만 오고 다시 안 받는다.",
        "source": "**/*.@(html|js|json|wasm)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "assets/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "canvaskit/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.apk",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "love-app-4e2ac",
          "appId": "1:498711263043:android:75fce18777a298303921f6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "love-app-4e2ac",
          "configurations": {
            "android": "1:498711263043:android:75fce18777a298303921f6",
            "ios": "1:498711263043:ios:d899367b806291ce3921f6"
          }
        }
      }
    }
  }
}
